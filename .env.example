# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public (Client-safe) Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Supabase Server-Only (Private - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cron Security Secret (for protected sync endpoints)
CRON_SECRET=your-random-cron-secret-min-32-chars

# Email Provider Configuration (Brevo SMTP, Resend, Mock)
EMAIL_PROVIDER=brevo
EMAIL_FROM="FedJobs Radar <notifications@fedjobsradar.com>"
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key

# USAJOBS Search API Configuration (Server-Only)
USAJOBS_API_KEY=your-usajobs-api-key
USAJOBS_USER_AGENT_EMAIL=your-registered-email@example.com
USAJOBS_BASE_URL=https://data.usajobs.gov
